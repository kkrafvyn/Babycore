# BabyCore Vercel Environment Template
# Copy these keys into Vercel Project Settings -> Environment Variables

# Canonical production app URL
VITE_APP_URL=https://babycore.vercel.app

# ==================== REQUIRED (Current Frontend Deployment) ====================
# Supabase (frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use either publishable key or anon key (publishable key preferred if your project uses it)
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# OAuth callback target for social providers (must be allow-listed in Supabase Auth -> URL Configuration)
VITE_SUPABASE_AUTH_REDIRECT_URL=https://babycore.vercel.app

# Supabase (serverless private keys for /api routes like admin overview)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Alias also supported by API code:
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Payments (frontend public keys)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_or_test_key
# Backward-compatible alias (optional): app now accepts this too
# VITE_PAYSTACK_LIVE_PUBLIC_KEY=pk_live_or_test_key
# Paystack dashboard URLs
PAYSTACK_CALLBACK_URL=https://babycore.vercel.app
PAYSTACK_WEBHOOK_URL=https://babycore.vercel.app/api/payments/webhook/paystack
# Compatibility webhook path also supported by app:
# https://babycore.vercel.app/api/webhooks/paystack
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE_or_TEST_key
# Flutterwave dashboard webhook
FLUTTERWAVE_WEBHOOK_URL=https://babycore.vercel.app/api/payments/webhook/flutterwave
# Compatibility webhook path also supported by app:
# https://babycore.vercel.app/api/webhooks/flutterwave
# Payments (serverless/private key for /api/payments/finalize)
PAYSTACK_SECRET_KEY=sk_live_or_test_secret_key
# Backward-compatible aliases (optional):
# PAYSTACK_SERVICE_KEY=sk_live_or_test_secret_key
# VITE_PAYSTACK_LIVE_SECRET_KEY=sk_live_or_test_secret_key

# Push notifications (public key only on frontend)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
# Push notifications for native mobile delivery via FCM (private key)
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key

# Email fallback (Google SMTP or any SMTP relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
# Compatibility aliases used by some backend utilities:
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM=noreply@babycore.app
# Optional: set true for SSL/TLS port 465
# SMTP_SECURE=false

# ==================== OPTIONAL (Only if those features are enabled in UI) ====================
# Note: VITE_ vars are exposed to the browser bundle.
# Avoid putting private provider secrets behind VITE_.
# These are included only because current client code references them.
VITE_SENDGRID_API_KEY=your_sendgrid_client_key_if_used
VITE_RESEND_API_KEY=your_resend_client_key_if_used

# ==================== OPTIONAL FLAGS ====================
VITE_ENABLE_HEALTH_ALERTS=true
VITE_ENABLE_WEARABLES=true
VITE_ENABLE_COMMUNITY=true
VITE_ENABLE_PREMIUM_FEATURES=true
VITE_ENABLE_VOICE_TRANSCRIPTION=true
VITE_ENABLE_AI_INSIGHTS=true
VITE_ENABLE_DOCTOR_SHARING=true
VITE_ENABLE_FAMILY_SHARING=true
VITE_ENABLE_PAYMENT_INTEGRATION=true

# ==================== OPTIONAL API URL OVERRIDES ====================
# Frontend defaults to same-origin /api on Vercel.
# Set only if your API is hosted on a separate domain.
# VITE_API_BASE_URL=https://api.your-domain.com/api
# VITE_API_BASE_URL_PROD=https://api.your-domain.com/api
# VITE_API_TIMEOUT=30000

# ==================== BACKEND (Only if API is deployed separately) ====================
# If you deploy a separate dedicated API service, add these in that backend environment:
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SECRET_KEY=your_supabase_service_role_key
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:support@babycore.app
# CLIENT_URL=https://babycore.vercel.app
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production
