{
  "name": "babylog",
  "version": "1.0.0",
  "description": "Complete baby care management and monitoring app with AI insights, premium features, and family sharing",
  "type": "module",
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "npm run dev:api & npm run dev:frontend",
    "dev:frontend": "vite",
    "dev:api": "tsx watch src/api/server.ts",
    "build": "npm run build:frontend",
    "build:full": "npm run build:frontend && npm run build:api",
    "build:frontend": "vite build",
    "build:api": "tsc --project tsconfig.server.json",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest",
    "test:e2e": "playwright test",
    "check:prod-config": "node scripts/check-prod-config.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "start": "node dist/api/server.js",
    "start:api": "node dist/api/server.js",
    "lighthouse": "lighthouse http://localhost:5173 --output-path=./lighthouse/report.html",
    "db:seed": "tsx scripts/seed.ts",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "generate:vapid": "web-push generate-vapid-keys",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.0.4",
    "@react-three/drei": "^9.100.0",
    "@react-three/fiber": "^8.15.0",
    "@supabase/supabase-js": "^2.38.4",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-table": "^8.16.0",
    "axios": "^1.6.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.1",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.263.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.1",
    "recharts": "^2.10.3",
    "sonner": "^2.0.7",
    "three": "^0.158.0",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@mapbox/node-pre-gyp": "^1.0.11",
    "@playwright/test": "^1.54.2",
    "@supabase/supabase-js": "^2.38.4",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pdfkit": "^0.12.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.0.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "lighthouse": "^11.2.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "shadcn-ui": "^0.8.0",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "baby",
    "parenting",
    "health",
    "tracking",
    "ai",
    "pwa",
    "supabase"
  ],
  "author": "BabyLog Team",
  "license": "MIT"
}
