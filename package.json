{
  "name": "babylog",
  "version": "1.0.0",
  "description": "Complete baby care management and monitoring app with AI insights, premium features, and family sharing",
  "type": "module",
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "vite --host localhost --strictPort --port 5173",
    "dev:frontend:host": "vite --host localhost --strictPort --port 5173",
    "dev:frontend:network": "vite --host 0.0.0.0 --strictPort --port 5173",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:full": "concurrently -n api,web -c yellow,cyan \"npm run dev:api\" \"npm run dev:frontend\"",
    "build": "npm run build:frontend",
    "build:full": "npm run build:frontend && npm run build:api",
    "build:frontend": "vite build",
    "build:api": "tsc --project tsconfig.server.json",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest",
    "test:e2e": "playwright test",
    "check:prod-config": "node scripts/check-prod-config.mjs",
    "check:schema": "node scripts/check-supabase-schema.mjs",
    "smoke:cold-start": "node scripts/smoke-cold-start.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "start": "node dist/api/server.js",
    "start:api": "node dist/api/server.js",
    "lighthouse": "lighthouse http://localhost:5173 --output-path=./lighthouse/report.html",
    "db:seed": "tsx scripts/seed.ts",
    "db:sync-migrations": "node scripts/sync-supabase-migrations.mjs",
    "supabase:linked": "node scripts/run-supabase-linked.mjs",
    "db:migration:list": "npm run supabase:linked -- migration list",
    "db:push:dry-run": "npm run supabase:linked -- db push --dry-run",
    "db:migrate": "npm run db:sync-migrations && npm run supabase:linked -- db push",
    "db:reset": "npm run db:sync-migrations && supabase db reset",
    "cap:prepare": "node scripts/stage-native-wearables-plugin.mjs",
    "cap:doctor": "node scripts/run-capacitor.mjs doctor",
    "cap:copy:ios": "npm run build:frontend && node scripts/run-capacitor.mjs copy ios",
    "cap:copy:android": "npm run build:frontend && node scripts/run-capacitor.mjs copy android",
    "cap:sync:ios": "npm run build:frontend && node scripts/run-capacitor.mjs sync ios",
    "cap:sync:android": "npm run build:frontend && node scripts/run-capacitor.mjs sync android",
    "cap:open:ios": "node scripts/run-capacitor.mjs open ios",
    "cap:open:android": "node scripts/run-capacitor.mjs open android",
    "cap:add:ios": "node scripts/run-capacitor.mjs add ios",
    "cap:add:android": "node scripts/run-capacitor.mjs add android",
    "generate:vapid": "web-push generate-vapid-keys",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@babycore/native-wearables": "file:plugins/native-wearables",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.0.4",
    "@react-three/drei": "^9.100.0",
    "@react-three/fiber": "^8.15.0",
    "@supabase/supabase-js": "^2.38.4",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-table": "^8.16.0",
    "axios": "^1.6.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.1",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.263.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.1",
    "recharts": "^2.10.3",
    "sonner": "^2.0.7",
    "three": "^0.158.0",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@playwright/test": "^1.54.2",
    "@supabase/supabase-js": "^2.38.4",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pdfkit": "^0.12.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.1.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "lighthouse": "^13.3.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "shadcn-ui": "^0.8.0",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "baby",
    "parenting",
    "health",
    "tracking",
    "ai",
    "pwa",
    "supabase"
  ],
  "author": "BabyLog Team",
  "license": "MIT",
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.2"
  }
}
