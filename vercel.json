{
  "version": 2,
  "buildCommand": "npm run build:frontend",
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps --no-fund --no-audit",
  "devCommand": "npm run dev",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
