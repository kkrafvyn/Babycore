# Environment Variables Template for Production
# Copy this file to .env.production and fill in actual values
# Vercel runtime vars such as VERCEL_URL, VERCEL_ENV, VERCEL_OIDC_TOKEN, and commit metadata
# are injected automatically by the platform and should not be committed here.

# ==================== CORE CONFIGURATION ====================
# Do not set NODE_ENV in this file. Vite warns when NODE_ENV is defined in .env.production.
# Set NODE_ENV=production in the deployment environment only if you run the separate Node API server.
VITE_APP_URL=https://babycore.vercel.app
PORT=3000
HOST=0.0.0.0
CLIENT_URL=https://babycore.vercel.app
VITE_DEBUG=false
VITE_LOG_LEVEL=info
DEBUG_API_REQUESTS=false
DEBUG_DATABASE_QUERIES=false

# ==================== DATABASE (Supabase) ====================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Required for server-side /api routes (admin overview, payment finalize, etc.)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# OAuth callback target for web/PWA social providers (must be allow-listed in Supabase Auth -> URL Configuration)
# For the native Android/iOS app, also allow-list: com.babylog.app://auth/callback
VITE_SUPABASE_AUTH_REDIRECT_URL=https://babycore.vercel.app

# ==================== PWA & NOTIFICATIONS ====================
# Local reminders work without native remote push.
# Set this to true only if you later wire Android/iOS remote push transport.
VITE_NATIVE_REMOTE_PUSH_ENABLED=false
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_SUBJECT=mailto:support@babycore.app
# Backend push sender keys (do not expose these to frontend)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
# Native mobile remote push:
# Android delivery uses Firebase Cloud Messaging and requires:
# - android/app/google-services.json
# - FCM HTTP v1 server credentials
# Option A: provide the full Android FCM service account JSON in one env var
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id","client_email":"firebase-adminsdk-xxxx@your-firebase-project-id.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Option B: provide the same Android FCM credentials as split env vars
FCM_PROJECT_ID=your_firebase_project_id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-firebase-project-id.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# iOS delivery uses APNs directly (no GoogleService-Info.plist is required for the Capacitor push plugin)
APNS_TEAM_ID=your_apple_team_id
APNS_KEY_ID=your_apns_key_id
APNS_AUTH_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
APNS_BUNDLE_ID=com.babylog.app
# Use true when testing Xcode-installed development builds; use false for TestFlight/App Store
APNS_USE_SANDBOX=true

# ==================== PAYMENT PROVIDERS ====================
# Paystack (Live Keys)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_live_key
PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key
PAYSTACK_CALLBACK_URL=https://babycore.vercel.app
PAYSTACK_WEBHOOK_URL=https://babycore.vercel.app/api/payments/webhook/paystack

# Flutterwave (Live Keys)
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE_your_live_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE_your_live_secret_key
FLUTTERWAVE_WEBHOOK_SECRET=your_webhook_secret
FLUTTERWAVE_WEBHOOK_URL=https://babycore.vercel.app/api/payments/webhook/flutterwave

# Stripe (Live Keys)
STRIPE_SECRET_KEY=sk_live_your_stripe_live_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_live_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ==================== EMAIL SERVICES ====================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@babycore.app

RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=support@babycore.app

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@babycore.app

# ==================== API ENDPOINTS ====================
# Web deployment can safely use same-origin /api.
VITE_API_BASE_URL=/api
VITE_API_BASE_URL_PROD=/api
# Bundled Capacitor apps run local web assets, so point native builds at the hosted API root.
VITE_NATIVE_API_BASE_URL=https://babycore.vercel.app/api
VITE_API_TIMEOUT=30000

# ==================== EXTERNAL HEALTH APIs ====================
WHO_API_BASE_URL=https://ghoapi.azureedge.net/api
WHO_OUTBREAK_ENDPOINT=/outbreak-news-feed
CDC_API_BASE_URL=https://www.cdc.gov/api/v1
CDC_ALERTS_ENDPOINT=/alerts
VITE_OPENWEATHER_API_KEY=your_openweather_key
OPENWEATHER_API_BASE_URL=https://api.openweathermap.org/data/3.0

# ==================== COMMUNICATION SERVICES ====================
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_SPEECH_API_KEY=your_google_speech_key
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# ==================== AI / COPILOT (OPTIONAL) ====================
# Used only if you want model-backed Care Copilot responses.
# Leave unset to use the built-in rules engine.
OPENAI_API_KEY=sk_your_openai_key
OPENAI_MODEL=gpt-4o-mini
# Optional if using an OpenAI-compatible proxy:
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==================== WEARABLES (OPTIONAL) ====================
# The current web app works without vendor APIs by using manual entry and CSV/JSON import.
# Use the keys below only if you later build native iOS/Android sync or OAuth imports.

# Apple Health / HealthKit:
# No web API key exists. Requires a native iOS app plus Apple Developer enrollment.
APPLE_HEALTH_TEAM_ID=your_apple_team_id
APPLE_HEALTH_BUNDLE_ID=com.babylog.app

# Android Health Connect:
# No browser API key exists. Requires an Android app integration.
ANDROID_HEALTH_CONNECT_PACKAGE=com.babylog.app

# Fitbit OAuth app:
FITBIT_CLIENT_ID=your_fitbit_client_id
FITBIT_CLIENT_SECRET=your_fitbit_client_secret

# Optional future wearable partners:
OURA_CLIENT_ID=your_oura_client_id
OURA_CLIENT_SECRET=your_oura_client_secret
GARMIN_CLIENT_ID=your_garmin_client_id
GARMIN_CLIENT_SECRET=your_garmin_client_secret

# ==================== CLOUD STORAGE ====================
AWS_S3_BUCKET=babylog-storage
AWS_S3_REGION=us-east-1
GCS_BUCKET=babylog-gcs-bucket
GCS_PROJECT_ID=your_gcp_project

# ==================== ANALYTICS & MONITORING ====================
SENTRY_DSN=https://your_sentry_dsn@sentry.io/your_project_id
SENTRY_ENVIRONMENT=production
MIXPANEL_TOKEN=your_mixpanel_token
GOOGLE_ANALYTICS_ID=GA-your-id
LOGROCKET_ID=babylog/babylog

# ==================== FEATURE FLAGS ====================
VITE_ENABLE_HEALTH_ALERTS=true
VITE_ENABLE_WEARABLES=true
VITE_ENABLE_COMMUNITY=true
VITE_ENABLE_PREMIUM_FEATURES=true
VITE_ENABLE_VOICE_TRANSCRIPTION=true
VITE_ENABLE_AI_INSIGHTS=true
VITE_ENABLE_DOCTOR_SHARING=true
VITE_ENABLE_FAMILY_SHARING=true
VITE_ENABLE_PAYMENT_INTEGRATION=true

# ==================== SECURITY ====================
ENCRYPTION_KEY=your_encryption_key_32_bytes
HASH_SALT_ROUNDS=10
CORS_ORIGIN=https://babycore.vercel.app

# ==================== CRON JOBS ====================
HEALTH_ALERTS_SYNC_INTERVAL=3600000
SUBSCRIPTION_RENEWAL_CHECK_INTERVAL=86400000
NOTIFICATION_SCHEDULER_INTERVAL=300000
